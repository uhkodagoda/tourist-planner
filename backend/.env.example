# Copy this file to .env and fill in your own values

# MySQL connection (matches the approved tech stack: MySQL via WAMP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tourist_planner

# Server
PORT=4000

# Admin auth
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# Optional: Google Maps JavaScript API key.
# If left blank, the frontend automatically falls back to a text/list view (per FR-11).
GOOGLE_MAPS_API_KEY=
